[Unit]
Description=FinKoper Kazakhstan CRM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kzcrm
Group=kzcrm
WorkingDirectory=/opt/kzcrm
EnvironmentFile=/opt/kzcrm/.env
ExecStart=/opt/kzcrm/kzcrm
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
